-- The Double Exponential Moving Average (DEMA) was developed by Patrick Mulloy.
-- It is used for smoothing price series and attempts to offer a smoothed average with less
-- lag than a straight exponential moving average (EMA). This indicator is usually plotted directly on a price chart.
declare function DEMA(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

interface DONCHIANResult { upper: HaasNumberCollection; middle: HaasNumberCollection; lower: HaasNumberCollection; 1: HaasNumberCollection; 2: HaasNumberCollection; 3: HaasNumberCollection; [index: number]: HaasNumberCollection }

-- The Donchian Channel (DONCHIAN), developed by Richard Donchian.
-- Donchian Channel is formed by taking the highest high and the lowest low of the last n periods.
-- The area between the high and the low is the channel for the period chosen. This indicator is usually plotted on the price chart.
declare function DONCHIAN(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, period: number | HaasNumberCollection): DONCHIANResult

-- The Detrended Price Oscillator (DPO) is an indicator
-- in technical analysis that attempts to eliminate the long-term trends in prices
-- by using a displaced moving average so it does not react to the most current price action.
-- This allows the indicator to show intermediate overbought and oversold levels effectively.
-- This indicator is usually plotted on its own chart.
declare function DPO(prices: number[] | HaasNumberCollection, shortLength: number | HaasNumberCollection, longLength: number | HaasNumberCollection): HaasNumberCollection

-- The Directional Movement Index (DX) is indicator in technical
-- analysis which is based on two other Welles Wilder's indicators: negative directional
-- indicator (-DI) and positive directional indicator (+DI). It was designed to evaluate
-- the strength of a trend and to define a period of sideways trading. This indicator is usually
-- plotted on its own chart.
declare function DX(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, close: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- Deactivates the bot after an enter order has been completed.
declare function DeactivateAfterEnterOrder(positionCount?: number | HaasNumberCollection): boolean

-- Deactivates the bot after an exit order has been completed.
declare function DeactivateAfterExitOrder(positionCount?: number | HaasNumberCollection): boolean

-- Deactivates the bot when the is active for a certain time.
declare function DeactivateAfterXActiveMinutes(minutes: number | HaasNumberCollection): boolean

-- Deactivates the bot if the last completed order is a number of minutes in the past. Timeout starts after the first completed order.
declare function DeactivateAfterXIdleMinutes(minutes: number | HaasNumberCollection): boolean

-- Deactivates the bot after a number of orders has been completed.
declare function DeactivateAfterXOrders(count?: number | HaasNumberCollection): boolean

-- Deactivates the bot after a number of positions has been completed.
declare function DeactivateAfterXPositions(count?: number | HaasNumberCollection): boolean

-- Deactivates the bot. Once the bot is deactivated, it can only manually activate again.
declare function DeactivateBot(reason?: string, cancelOpenOrders?: boolean): nil

-- Deactivates the bot when there is no open position and the ROI based losses have reached a certain level.
declare function DeactivateOnLoss(maxLoss: number | HaasNumberCollection): boolean

-- Deactivates the bot when there is no open position and the ROI based profits have reached a certain level.
declare function DeactivateOnProfit(minProfit: number | HaasNumberCollection): boolean

-- This defines the name and description of the custom command. This information will reflect in commands/block lists and help models.
declare function DefineCommand(name: string, description: string): nil

-- Defines the signal output for the custom indicator.
declare function DefineEasyIndicatorOutput(result: Enum): nil

interface DefineEasyIndicatorParametersResult { chartIndex: number; interval: number; 1: number; 2: number; [index: number]: number }

-- Defines the chartIndex and interval parameter.
declare function DefineEasyIndicatorParameters(chartIndex?: number | HaasNumberCollection): DefineEasyIndicatorParametersResult

-- Optimizes the custom command for back tests. Only use this if the command needs updates once every interval tick.
declare function DefineIntervalOptimization(interval: number | HaasNumberCollection): nil

-- Defines the output type and data.
declare function DefineOutput(type: EnumParameterType, value?: any | nil, description?: string, outputSuggestions?: string | nil): nil

-- Creates an index based output connection to be used in the visual editor.
declare function DefineOutputIndex(index: number | HaasNumberCollection, type: EnumParameterType, name: string, description: string, outputSuggestions?: string | nil): nil

-- Defines the parameter for a custom command.
declare function DefineParameter(type: EnumParameterType, name: string, description: string, isRequired: boolean, defaultValue: any, inputSuggestions?: string | nil): any

-- Saves and delays a signal by a number of minutes.
declare function DelaySignal(signal: Enum, minutes: number | HaasNumberCollection): EnumSignal

-- Deletes a value on a specific key.
declare function Delete(key: string): nil

-- Calculates the percentage between input1 and input2 or the percentage change between the values of input1.
declare function Delta(input1: number | number[] | HaasNumberCollection, input2?: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Disables IndicatorContainer log messages.
declare function DisableIndicatorContainerLogs(): nil

-- Divides input1 with input2. If one of the parameters is a single value, the other is divided by this.
declare function Div(input1: number | number[] | HaasNumberCollection, input2: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Generates a buy signal on spot or a long signal on margin & leverage.
declare function DoBuy(note?: string): nil

-- Sends out a sell signal on spot or an exit positions signal on margin & leverage.
declare function DoExitPosition(note?: string): nil

-- Executes a DoLong() when the current position is short and an DoShort() the position is long.
declare function DoFlipPosition(note?: string): nil

-- Generates a buy signal on spot or a long signal on margin & leverage.
declare function DoLong(note?: string): nil

-- Generates a sell signal on spot or a short signal on margin & leverage.
declare function DoSell(note?: string): nil

-- Generates a sell signal on spot or a short signal on margin & leverage.
declare function DoShort(note?: string): nil

-- Processes a signal enum. Triggers a DoLong() when the signal equals SignalLong, a DoShort() when the signal equals SignalShort, a DoExitPosition() when the signal equals SignalExitPosition, exits only the long position when the signal equals SignalExitLong, exits only the short position when the signal equals SignalExitShort (both do nothing when that side has no position, and SignalExitShort never trades on spot) and does nothing when the signal is SignalNone.
declare function DoSignal(signal: Enum, note?: string): nil

-- Calculates the dynamic stop loss price and compares it with the current exit price.
declare function DynamicStopLoss(percentage: number | HaasNumberCollection, depth?: number | HaasNumberCollection, positionId?: string, direction?: EnumPosition): boolean

-- Calculates the dynamic take profit price and compares it with the current exit price.
declare function DynamicTakeProfit(percentage: number | HaasNumberCollection, depth?: number | HaasNumberCollection, positionId?: string, direction?: EnumPosition): boolean

-- The Exponential Moving Average (EMA) is a weighted moving average
-- (WMA) that gives more weighting, or importance, to recent price data than the simple moving average (SMA) does.
