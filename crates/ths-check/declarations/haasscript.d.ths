-- Enables high-speed script execution, running the script on every price tick instead of once per minute. With guaranteeInterval enabled, the script will execute at least once every 10 seconds even if no price ticks arrive.
declare function EnableHighSpeedUpdates(updateOnFilledOrders?: boolean, guaranteeInterval?: boolean): nil

-- Enables order persistence for managed trading.
declare function EnableOrderPersistence(): nil

-- Compares two values and returns whether or not the values are equal.
declare function Equals(value1: any, value2: any): boolean

-- Calculates 'e' raised to the specified power.
declare function Exp(input: number | number[] | HaasNumberCollection): HaasNumberCollection

interface FastRSIResult { rsi: HaasNumberCollection; fastRsi: HaasNumberCollection; 1: HaasNumberCollection; 2: HaasNumberCollection; [index: number]: HaasNumberCollection }

-- The FastRSI is a custom implementation from Haasonline. It uses a custom RSI and EMA calculation.
declare function FastRSI(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection, signal: number | HaasNumberCollection): FastRSIResult

-- Gets the current fee percentage of the main or specific market.
declare function Fee(market?: string): number

-- Filters out all values above a specific value.
declare function FilterAbove(input: number | number[] | HaasNumberCollection, threshold: number | HaasNumberCollection): HaasNumberCollection

-- Filters out all values below a specific value.
declare function FilterBelow(input: number | number[] | HaasNumberCollection, threshold: number | HaasNumberCollection): HaasNumberCollection

-- Only executes on the last update cycle of a backtest. Saving time in the overall backtest length. Can be used in combination with plot manipulation (eg. PlotDoubleColor()) or CustomReport()
declare function Finalize(callback?: any): boolean

-- Calculates the largest integral value less than or equal to the specified number.
declare function Floor(input: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Formats a unix datetime number (to "YYYY-MM-DD at HH:MM" by default).
declare function FormatDateTime(unix?: number | HaasNumberCollection, dateDelimiter?: string, dateTimeDelimiter?: string, timeDelimiter?: string, includeSeconds?: boolean, includeTime?: boolean, includeYear?: boolean): string

-- Returns a continuous signal when values are above/below of each other.
declare function GetAboveBelowSignal(fast: number | HaasNumberCollection, slow: number | HaasNumberCollection): EnumSignal

-- An array of markets affiliated with a particular account.
declare function GetAccountMarkets(accountId?: string): any

-- A collection of (partially) filled orders executed by the bot. Maximum size is 50 orders.
declare function GetAllFilledOrders(positionId?: string): any

-- A collection of open orders executed by the bot.
declare function GetAllOpenOrders(positionId?: string): any

-- Gets all open positions and returns them as PositionContainers.
declare function GetAllOpenPositions(): any

interface GetAllUserPositionsResult { positionId: string; accountId: string; market: string; isLong: boolean; isShort: boolean; enterPrice: number; amount: number; profit: number; roi: number; leverage: number; direction: EnumPosition; 1: string; 2: string; 3: string; 4: boolean; 5: boolean; 6: number; 7: number; 8: number; 9: number; 10: number; 11: EnumPosition; [index: number]: EnumPosition | boolean | number | string }

-- Gets the positions the exchange reports for the account, independent of the bot position ledger. Use it to detect positions the bot did not open itself. On a managed bot the account snapshot only covers the bot's own market; unmanaged bots see every market on the account.
declare function GetAllUserPositions(accountId?: string, market?: string): GetAllUserPositionsResult

-- A collection with the highest price of the candle its body prices. Sorted from new to old.
declare function GetBodyHighPrices(interval?: number | HaasNumberCollection, fullCandles?: boolean, market?: string, hlcStyle?: boolean): HaasNumberCollection

-- A collection with the lowest price of the candle its body prices. Sorted from new to old.
declare function GetBodyLowPrices(interval?: number | HaasNumberCollection, fullCandles?: boolean, market?: string, hlcStyle?: boolean): HaasNumberCollection

-- Total realized profits on a specific market. Unrealized profits are included when 'includeUnrealized' is set on true.
declare function GetBotProfit(market?: string, includeUnrealized?: boolean): number

-- Gets the return on investment. The ROI is calculated by dividing the total realized profits by the average position size.
declare function GetBotROI(market?: string): number

-- Determines the signal from a result with a buy and sell level.
declare function GetBuySellLevelSignal(value: number | HaasNumberCollection, buyLevel: number | HaasNumberCollection, sellLevel: number | HaasNumberCollection): EnumSignal

-- Gets a command by name.
declare function GetCommand(name: string): any

-- Counts the number of signals. When the majority agrees it will return the signal.
declare function GetConsensusSignal(...: Enum): EnumSignal

-- Determines the signal from a result with a crossover or -under level.
declare function GetCrossOverUnderSignal(fast: number | number[] | HaasNumberCollection, slow: number | number[] | HaasNumberCollection): EnumSignal

-- Gets unrealized plus realized profits of the current open position. Optional parameters fall back to main bot settings. The accountId parameter can take a positionId as well.
declare function GetCurrentProfit(direction?: EnumPosition, market?: string): number

-- Gets the return on investment percentage based on the total cost/margin used of the open positions. Optional parameters fall back to main bot settings. The accountId parameter can take a positionId as well.
declare function GetCurrentROI(direction?: EnumPosition, market?: string): number

-- An array of markets affiliated with a particular exchange.
declare function GetExchangeMarkets(exchangeCode: string): any

-- The reason for the order failure.
declare function GetFailedOrderMessage(orderId: string): string

-- Gets the current HaasScript version as a number.
declare function GetHaasScriptVersion(): number

-- Gets the highest value.
declare function GetHigh(prices: number[] | HaasNumberCollection, depth: number | HaasNumberCollection, offset?: number | HaasNumberCollection): number

-- Gets the highest values within lookback period.
declare function GetHighs(array: number[] | HaasNumberCollection, depth: number | HaasNumberCollection): HaasNumberCollection

-- Gets a list of the last trades.
declare function GetLastTrades(depth?: number | HaasNumberCollection, market?: string): HaasNumberCollection

-- Gets the set leverage for current or specified market.
declare function GetLeverage(market?: string, accountId?: string): number

-- Gets the lowest value.
declare function GetLow(prices: number[] | HaasNumberCollection, depth: number | HaasNumberCollection, offset?: number | HaasNumberCollection): number

-- Gets the lowest values within lookback period.
declare function GetLows(array: number[] | HaasNumberCollection, depth: number | HaasNumberCollection): HaasNumberCollection

-- Gets the maximum leverage for current or specified market.
declare function GetMaxLeverage(market?: string): number

-- Calculates the cancelled amount if the order is completed/cancelled.
declare function GetOrderCancelledAmount(orderId: string): number

-- Calculates the amount filled for a specific order.
declare function GetOrderFilledAmount(orderId: string, afterFees?: boolean): number

-- Calculates how long an order is or has been open in minutes.
declare function GetOrderOpenTime(orderId: string, inSeconds?: boolean): number

-- Calculates the realized profits of the order.
declare function GetOrderProfit(orderId: string): number

interface GetOrderbookResult { askPrices: HaasNumberCollection; askAmounts: HaasNumberCollection; bidPrices: HaasNumberCollection; bidAmounts: HaasNumberCollection; 1: HaasNumberCollection; 2: HaasNumberCollection; 3: HaasNumberCollection; 4: HaasNumberCollection; [index: number]: HaasNumberCollection }

-- Gets the orderbook on a specific market.
declare function GetOrderbook(market?: string): GetOrderbookResult

-- Gets a list of the orderbook ask records.
declare function GetOrderbookAsk(market?: string): any

-- Gets a list of the orderbook bid records.
declare function GetOrderbookBid(market?: string): any

-- Gets the total amount open in a specific position.
declare function GetPositionAmount(positionId?: string): number

-- Gets the direction of a specific position.
declare function GetPositionDirection(positionId?: string): EnumPosition

-- Gets the average enter price of an open position.
declare function GetPositionEnterPrice(positionId?: string): number

-- Gets the market of an open position.
declare function GetPositionMarket(positionId?: string): string

-- Gets the total realized plus unrealized profit of a specific position.
declare function GetPositionProfit(positionId?: string, targetPrice?: number | HaasNumberCollection): number

-- Calculates the ROI based on used margin and unrealized + realized profits.
declare function GetPositionROI(positionId?: string, targetPrice?: number | HaasNumberCollection): number

-- Gets the remote signal which is published by SaveRemoteSignal() or the STORE_SIGNAL webhook. An incoming webhook signal triggers an immediate script execution, bypassing the normal tick interval.
declare function GetRemoteSignal(id: string): EnumSignal

-- Returns a continuous trade signal with defined signal type and values.
declare function GetSuperSignal(indicatorValue: number[] | HaasNumberCollection, signalValue: number[] | HaasNumberCollection, signalType: Enum, centerPosition?: number | HaasNumberCollection, buyLevel?: number | HaasNumberCollection, sellLevel?: number | HaasNumberCollection): EnumSignal

-- Calculates the amount of swing in percentages.
declare function GetSwing(input1: number | number[] | HaasNumberCollection, input2: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Determines the signal based on a result and a threshold.
declare function GetThresholdSignal(value: number | HaasNumberCollection, threshold: number | HaasNumberCollection, swing?: number | HaasNumberCollection): EnumSignal

-- Gets the elapsed time for a timer.
declare function GetTimer(key?: string): number

interface GetTradingReportResult { maxDrawDownPrc: number; maxDrawDown: number; sharpeRatio: number; sortinoRatio: number; winPercentage: number; profitRatio: number; profitFactor: number; cpcIndex: number; tailRatio: number; commonSenseRatio: number; outlierWinRatio: number; outlierLossRatio: number; profitMarginRatio: number; biggestWin: number; biggestLoss: number; highestPointInProfit: number; lowestPointInProfit: number; totalMarginUsed: number; averageMargin: number; averageProfit: number; closedPositions: number; profitablePositions: number; losingPositions: number; executedOrders: number; completedOrders: number; 1: number; 2: number; 3: number; 4: number; 5: number; 6: number; 7: number; 8: number; 9: number; 10: number; 11: number; 12: number; 13: number; 14: number; 15: number; 16: number; 17: number; 18: number; 19: number; 20: number; 21: number; 22: number; 23: number; 24: number; 25: number; [index: number]: number }

-- Gets the trading report container with many useful values to help properly evaluate a strategy or a trading system.
declare function GetTradingReport(market?: string): GetTradingReportResult

-- Validates if all signals are the same.
declare function GetUnanimousSignal(...: Enum): EnumSignal

-- A collection with volume data. Sorted from new to old.
declare function GetVolume(interval?: number | HaasNumberCollection, fullCandles?: boolean, market?: string, hlcStyle?: boolean): HaasNumberCollection

-- Gets the latest incoming webhook signal by ID. Triggers immediate script execution when a webhook arrives, bypassing the normal minute tick interval - use this for high-performance signal-based trading.
declare function GetWebHookSignal(id: string): any

-- Calculates and determines the weighted consensus signal.
declare function GetWeightedConsensusSignal(longWeight: number | HaasNumberCollection, shortWeight: number | HaasNumberCollection, exitWeight: number | HaasNumberCollection, ...: Enum): EnumSignal

-- Keeps track of the highest/lowest recorded price and adjust the stop loss accordingly. The higher the price change the more the trailing distances grows.
declare function GrowingTrailingStopLoss(percentage: number | HaasNumberCollection, growPercentage: number | HaasNumberCollection, positionId?: string, direction?: EnumPosition): boolean

-- A collection with the average of high, low and close prices. Sorted from new to old.
declare function HLCPrices(interval?: number | HaasNumberCollection, fullCandles?: boolean, market?: string, hlcStyle?: boolean): HaasNumberCollection

-- A collection with an average of high and low prices. Sorted from new to old.
declare function HLPrices(interval?: number | HaasNumberCollection, fullCandles?: boolean, market?: string, hlcStyle?: boolean): HaasNumberCollection

-- HNC is an array on which match can be applied directly. This is not position with the lua code `{}`.
declare function HNC(size?: number | HaasNumberCollection, value?: number | HaasNumberCollection): HaasNumberCollection

-- Hilbert Transform - The Dominant Cycle Period (HT_DCPERIOD).
-- The Hilbert Transform is a technique used to generate inphase and quadrature components
-- of a de-trended real-valued "analytic-like" signal (such as a Price Series) in order
-- to analyze variations of the instantaneous phase and amplitude. HTPeriod (or MESA Instantaneous Period)
-- returns the period of the Dominant Cycle of the analytic signal as generated by the Hilbert Transform.
-- The Dominant Cycle can be thought of as being the "most likely" period (in the range of 10 to 40)
-- of a sine function of the Price Series.
declare function HT_DCPERIOD(prices: number[] | HaasNumberCollection): HaasNumberCollection

-- Hilbert Transform - The Dominant Cycle Phase (HT_DCPHASE)
-- The Hilbert Transform is a technique used to generate inphase and quadrature components
-- of a de-trended real-valued "analytic-like" signal (such as a Price Series) in order
-- to analyze variations of the instantaneous phase and amplitude. HTDCPhase returns the
-- Hilbert Transform Phase of the Dominant Cycle. The Dominant Cycle Phase lies in the
-- range of 0 to 360 degrees.
declare function HT_DCPHASE(prices: number[] | HaasNumberCollection): HaasNumberCollection

interface HT_PHASORResult { inPhaseOut: HaasNumberCollection; quadratureOut: HaasNumberCollection; 1: HaasNumberCollection; 2: HaasNumberCollection; [index: number]: HaasNumberCollection }

-- Hilbert Transform - The Phasor Components (HT_PHASOR)
-- The Hilbert Transform is a technique used to generate inphase and quadrature components
-- of a de-trended real-valued "analytic-like" signal (such as a Price Series) in order
-- to analyze variations of the instantaneous phase and amplitude.
-- In-Phase is the Hilbert Transform generated In-Phase component of the input Price Series.
-- Quadrature is the Hilbert Transform generated Quadrature component of the input Price Series.
declare function HT_PHASOR(prices: number[] | HaasNumberCollection): HT_PHASORResult

interface HT_SINEResult { sine: HaasNumberCollection; leadSine: HaasNumberCollection; 1: HaasNumberCollection; 2: HaasNumberCollection; [index: number]: HaasNumberCollection }

-- Hilbert Transform - The SineWave (HT_SINE)
-- The Hilbert Transform is a technique used to generate inphase and quadrature components
-- of a de-trended real-valued "analytic-like" signal (such as a Price Series) in order
-- to analyze variations of the instantaneous phase and amplitude. HTDCPhase returns the
-- Hilbert Transform Phase of the Dominant Cycle. The Dominant Cycle Phase lies in the
-- range of 0 to 360 degrees.
-- The Hilbert Transform Sine is just the sine of the DC Phase.
-- The Hilbert Transform Lead Sine is just the sine of the DC Phase advanced by 45 degrees.
declare function HT_SINE(prices: number[] | HaasNumberCollection): HT_SINEResult

-- Hilbert Transform - The Trend Line (HT_TRENDLINE)
-- The Hilbert Transform is a technique used to generate inphase and quadrature components
-- of a de-trended real-valued "analytic-like" signal (such as a Price Series) in order
-- to analyze variations of the instantaneous phase and amplitude. HTTrendline (or MESA Instantaneous Trendline)
-- returns the Price Series value after the Dominant Cycle of the analytic signal as generated by the Hilbert
-- Transform has been removed. The Dominant Cycle can be thought of as being the "most likely" period
-- (in the range of 10 to 40) of a sine function of the Price Series.
declare function HT_TRENDLINE(prices: number[] | HaasNumberCollection): HaasNumberCollection

-- Hilbert Transform - The Trend Mode (HT_TRENDMODE).
declare function HT_TRENDMODE(prices: number[] | HaasNumberCollection): HaasNumberCollection

-- A collection with the average of open, high, low and close prices. Sorted from new to old.
declare function HeikenClosePrices(interval?: number | HaasNumberCollection, fullCandles?: boolean, market?: string, hlcStyle?: boolean): HaasNumberCollection

-- Gets the Heikin-Ashi open prices.
declare function HeikinOpenPrices(interval?: number | HaasNumberCollection, fullCandles?: boolean, market?: string): HaasNumberCollection

-- Hides the 2 order settings fields.
declare function HideOrderSettings(): nil

-- Hides the 2 trade amount settings fields.
declare function HideTradeAmountSettings(): nil

-- A collection with high prices. Sorted from new to old.
declare function HighPrices(interval?: number | HaasNumberCollection, fullCandles?: boolean, market?: string, hlcStyle?: boolean): HaasNumberCollection

interface ICHIMOKUResult { conversion: HaasNumberCollection; base: HaasNumberCollection; spanA: HaasNumberCollection; spanB: HaasNumberCollection; 1: HaasNumberCollection; 2: HaasNumberCollection; 3: HaasNumberCollection; 4: HaasNumberCollection; [index: number]: HaasNumberCollection }

-- The Ichimoku Clouds (ICHIMOKU) also known as Ichimoku Kinko Hyo, developed by journalist Goichi Hosoda,
-- is a versatile indicator that defines support and resistance, identifies trend direction, gauges momentum and provides trading signals.
-- Ichimoku Kinko Hyo translates into "one look equilibrium chart". With one look, chartists
-- can identify the trend and look for potential signals within that trend. Even though the
-- Ichimoku Cloud may seem complicated when viewed on the price chart, it's actually a rather
-- straightforward indicator; the concepts are easy to understand and the signals are well-defined.
declare function ICHIMOKU(prices: number[] | HaasNumberCollection, tenkansen: number | HaasNumberCollection, kijunsen: number | HaasNumberCollection, senkouspanb: number | HaasNumberCollection): ICHIMOKUResult

-- The Intraday Momentum Index (IMI), developed by Tushar Chande,
-- combines aspects of candlestick analysis with the relative strength index (RSI). The intraday
-- indicator was designed to provide investors with a way to find optimal days to buy and sell.
declare function IMI(open: number[] | HaasNumberCollection, close: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- Marks the signal to be ignored when it matches a certain signal.
declare function IgnoreSignalIf(signal: Enum, signalToIgnore: Enum): EnumSignal

-- Initialize a file that can be exported later. Rows are written with WriteExportData, which only records during a backtest. Cloud servers allow up to 25 export files per script.
declare function InitExportData(name: string, ...: string): nil

-- Creates a script input field. The type is depending on the default value. It can be a number, text or boolean (checkbox) field. Without default value, it will be a text field.
declare function Input(label: string, defaultValue?: any, tooltip?: string, group?: string): any

-- Creates an account selection field.
declare function InputAccount(label: string, tooltip?: string, group?: string): string

-- Creates an account drop-down and a market drop-down for that account.
declare function InputAccountMarket(label: string, tooltip?: string, group?: string): string

-- Creates a button in the input field. When press in the UI, the bot will receive the action and execute the callback defined in the parameters.
declare function InputButton(label: string, callback: (...: any) => any, tooltip?: string, group?: string): nil

-- Creates a dropdown with available Candlestick Pattern (CDL) types. Can be used in combination with CDL().
declare function InputCdlTypes(label: string, defaultValue: EnumCandlePattern, tooltip?: string, group?: string): EnumCandlePattern

-- Creates a group header, separating input sets.
declare function InputGroupHeader(label: string): nil

-- Creates an interval dropdown.
declare function InputInterval(label: string, defaultValue?: number | HaasNumberCollection, tooltip?: string, group?: string): number

-- Creates a dropdown with the available LR types.
declare function InputLrTypes(label: string, defaultValue?: EnumTradingLR, tooltip?: string, group?: string): EnumTradingLR

-- Creates a dropdown with available MA types. Can be used in combination with a variety of technical indicators like BBANDS() or PPO().
declare function InputMaTypes(label: string, defaultValue: EnumMovingAverages, tooltip?: string, group?: string): EnumMovingAverages

-- Creates a market dropdown. The market options are related to the main account selection.
declare function InputMarket(label: string, defaultValue?: string, tooltip?: string, group?: string): string

-- Creates a dropdown with custom options.
declare function InputOptions(label: string, defaultValue: string, options: any, tooltip?: string, group?: string): string

-- Creates a dropdown with the default available order types.
declare function InputOrderType(label: string, defaultValue?: EnumOrderTypes, tooltip?: string, group?: string): EnumOrderTypes

-- Creates a price source dropdown.
declare function InputPriceSource(label: string, defaultValue?: string, tooltip?: string, group?: string): string

-- Creates a price source & market dropdown.
declare function InputPriceSourceMarket(label: string, defaultValue?: string, type?: EnumTrading, tooltip?: string, group?: string): string

-- Creates a dropdown with available Signal Types. Can be used in combination with GetSuperSignal().
declare function InputSignalTypes(label: string, defaultValue: EnumSignalTypes, tooltip?: string, group?: string): EnumSignalTypes

-- Creates a dropdown with available Source Price types. Can be used in combination with SourcePrices().
declare function InputSourcePrice(label: string, defaultValue: EnumSourcePriceTypes, tooltip?: string, group?: string): EnumSourcePriceTypes

-- Creates a dynamic input table.
declare function InputTable(options: any, ...: any): any

-- Creates an table column options object for InputTable()
declare function InputTableColumn(name: string, ...: any): any

-- Creates a table column options object for InputTable() with a dropdown.
declare function InputTableColumnDropdown(name: string, options: any, ...: any): any

-- Creates an options object for InputTable().
declare function InputTableOptions(title?: string, rows?: number | HaasNumberCollection, maxRows?: number | HaasNumberCollection, group?: string): any

-- Validates if all the signals agree.
declare function InsuranceContainer(...: boolean): boolean

-- Looks at a numeric array and checks whether its newest (first) value lies within multiplier standard deviations of the average. Not available in the cloud version.
declare function IsAbnormal(dataset: number[] | HaasNumberCollection, multiplier: number | HaasNumberCollection): boolean

-- Checks if there are any open orders completed/cancelled.
declare function IsAnyOrderFinished(positionId?: string): boolean

-- Checks if there are any open orders.
declare function IsAnyOrderOpen(positionId?: string): boolean

-- Checks if the value is bigger than lowValue and smaller then highValue.
declare function IsBiggerAndSmallerThan(value: number | number[] | HaasNumberCollection, lowValue: number | HaasNumberCollection, highValue: number | HaasNumberCollection): boolean

-- Checks if the value is bigger than highValue or smaller then lowValue.
declare function IsBiggerOrSmallerThan(value: number | number[] | HaasNumberCollection, highValue: number | HaasNumberCollection, lowValue: number | HaasNumberCollection): boolean

-- Checks if input1 is bigger than input2.
declare function IsBiggerThan(input1: number | number[] | HaasNumberCollection, input2: number | HaasNumberCollection): boolean

-- Used in combination with Pause- & ResumeBot(). The value can also be updated manually though the UI.
declare function IsBotPaused(): boolean

-- Checks if the given order is a buy order.
declare function IsBuyOrder(orderId: string | nil): boolean

-- Checks whether the candle that closed last is complete in the prices this update reads. Right after a candle closes, a bot with high-speed updates can run before the exchange's last minute of that candle is stored. Until then the closed candle's close and volume can still change. The answer matches the price commands in the same update, so check it first in the update, before acting on fullCandles data at a candle boundary. Built-in indicators keep their result for the candle only once it is complete, so they follow this answer. OptimizedForInterval callbacks, custom commands and SourceManager still run once per candle, so skip them for that interval while this returns false. Always true in backtests. Also true 45 seconds after the boundary, because a minute without trades is never stored. Waits for that timeout on weekly and monthly intervals, on very deep price histories, and on markets with no trade in the candle's last minute.
declare function IsClosedCandleFinal(interval?: number | HaasNumberCollection, market?: string): boolean

-- Returns true if running the enterprise version. Otherwise false.
declare function IsEnterpriseVersion(): boolean

-- Checks if the values are decreasing towards the newest within the lookback period.
declare function IsFalling(array: number[] | HaasNumberCollection, lookback: number | HaasNumberCollection): boolean

-- Counts the number of falling ticks.
declare function IsFallingSince(array: number[] | HaasNumberCollection, lookback: number | HaasNumberCollection): number

-- Checks if the specified margin mode is supported on current or specified market.
declare function IsMarginModeSupported(marginMode: EnumMarginMode, accountId?: string): boolean

-- Checks if the value is not null.
declare function IsNotNull(value: any | nil): boolean

-- Checks if the value is null.
declare function IsNull(value: any | nil): boolean

-- Checks if the given order is filled.
declare function IsOrderFilled(orderId: string | nil): boolean

-- Checks if the given order is still open.
declare function IsOrderOpen(orderId: string | nil): boolean

-- Checks whether or not a position is closed.
declare function IsPositionClosed(positionId?: string): boolean

-- Checks if specified position mode is supported on current or specified market.
declare function IsPositionModeSupported(positionMode: EnumPositionMode, accountId?: string): boolean

-- Checks if the values are increasing towards the newest within the lookback period.
declare function IsRising(array: number[] | HaasNumberCollection, lookback: number | HaasNumberCollection): boolean

-- Counts the number of rising ticks.
declare function IsRisingSince(array: number[] | HaasNumberCollection, lookback: number | HaasNumberCollection): number

-- Checks if the given order is a sell order.
declare function IsSellOrder(orderId: string | nil): boolean

-- Checks if input1 is smaller than input2.
declare function IsSmallerThan(input1: number | number[] | HaasNumberCollection, input2: number | HaasNumberCollection): boolean

-- Gets whether or not the trade amount is high enough for exchange limits.
declare function IsTradeAmountEnough(market: string, price: number | HaasNumberCollection, amount: number | HaasNumberCollection, logWarning?: boolean, reduceOnlyExit?: boolean): boolean

-- Checks if the input is a valid market.
declare function IsValidMarket(market: string): boolean

-- The Kaufman's Adaptive Moving Average (KAMA), developed by Perry Kaufman,
-- is an intelligent moving average. The powerful trend-following indicator is based on the
-- Exponential Moving Average (EMA) and is responsive to both trend and volatility.
-- Like all moving averages, the KAMA can be used to visualize the trend. This indicator is usually plotted on the price chart.
declare function KAMA(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection, fastest?: number | HaasNumberCollection, slowest?: number | HaasNumberCollection): HaasNumberCollection

-- The Kaufman's Adaptive Moving Average (KAMA2), developed by Perry Kaufman,
-- is an intelligent moving average. The powerful trend-following indicator is based on the
-- Exponential Moving Average (EMA) and is responsive to both trend and volatility.
-- Like all moving averages, the KAMA can be used to visualize the trend. This indicator is usually plotted on the price chart.
declare function KAMA2(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection, fastest?: number | HaasNumberCollection, slowest?: number | HaasNumberCollection): HaasNumberCollection

interface KELTNERResult { upper: HaasNumberCollection; middle: HaasNumberCollection; lower: HaasNumberCollection; 1: HaasNumberCollection; 2: HaasNumberCollection; 3: HaasNumberCollection; [index: number]: HaasNumberCollection }

-- The Keltner Channel (KELTNER), originally developed by Chester Keltner, extended by Linda Bradford Raschke,
-- uses a volatility-based envelopes set above and below an exponential moving average.
-- This indicator is similar to Bollinger Bands, which use the standard deviation (STDDEV)
-- to set the bands. Instead of using the standard deviation, Keltner Channels use
-- the Average True Range (ATR) to set channel width. The channels are typically
-- set 2x ATR values above and below the EMA. The exponential
-- moving average dictates direction and the Average True Range sets channel width.
-- Keltner Channels are a trend following indicator used to identify reversals with
-- channel breakouts and channel direction. Channels can also be used to identify
-- overbought and oversold levels when the market is ranging. This indicator is usually plotted on the price chart.
declare function KELTNER(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, close: number[] | HaasNumberCollection, emaPeriod: number | HaasNumberCollection, atrPeriod?: number | HaasNumberCollection, multiplier?: number | HaasNumberCollection): KELTNERResult

-- Kairi method (KRI) is similar to Momentum according to its application mode.
-- The oscillator fluctuates around 0 but the fluctuation range is wider. KRI can be used for any time frame.
-- It is one of the simplest oscillators. When creating the indicator, deviation of a price from its simple
-- moving average is calculated and the result is shown in percentage of the average.
declare function KRI(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

interface KSTResult { kst: HaasNumberCollection; signal: HaasNumberCollection; 1: HaasNumberCollection; 2: HaasNumberCollection; [index: number]: HaasNumberCollection }

-- Know Sure Thing (KST), developed by Martin Pring, is a momentum oscillator based on the smoothed
-- Rate-of-Change (ROC) for four different periods. In short, KST measures price momentum for four different price cycles, combining
-- them into a single momentum oscillator. Like any other unbound momentum oscillator, chartists can use KST to look for divergences, signal
-- line crossovers, and centerline crossovers. Pring frequently applied trend lines to KST. Although trend line signals do not occur
-- often, Pring notes that such breaks reinforce signal line crossovers. This indicator is usually plotted on its own chart.
declare function KST(prices: number[] | HaasNumberCollection, rocPeriod1: number | HaasNumberCollection, rocSmaPeriod1: number | HaasNumberCollection, rocPeriod2: number | HaasNumberCollection, rocSmaPeriod2: number | HaasNumberCollection, rocPeriod3: number | HaasNumberCollection, rocSmaPeriod3: number | HaasNumberCollection, rocPeriod4: number | HaasNumberCollection, rocSmaPeriod4: number | HaasNumberCollection, signalPeriod: number | HaasNumberCollection): KSTResult

-- The Linear Regression (LINEARREG)
-- is a trend following indicator that plots a dynamic version of the linear
-- regression indicator. The concept is to track the trend not using basic
-- averages or weighted averages - as in the case of moving averages - but
-- rather by taking the "best fit" line to match the data.
declare function LINEARREG(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection, type?: EnumTradingLR): HaasNumberCollection

-- Returns the volume of the last buy trades.
declare function LastBuyTradesCommand(secondsBack?: number | HaasNumberCollection, market?: string): number

-- Gets the last used exit long price.
declare function LastExitLongPrice(): number

-- Gets the last used exit short or long price.
declare function LastExitPositionPrice(): number

-- Gets the last used exit short price.
declare function LastExitShortPrice(): number

-- Gets the last enter long price.
declare function LastLongPrice(): number

-- Gets the profit of the last long exit or sell trade.
declare function LastLongProfit(positionId?: string): number

-- Returns the volume of the last sell trades.
declare function LastSellTradesCommand(secondsBack?: number | HaasNumberCollection, market?: string): number

-- Gets the last enter short price.
declare function LastShortPrice(): number

-- Gets the profit of the last short exit or buy trade.
declare function LastShortProfit(positionId?: string): number

-- Calculates the last trades sentiment as a number.
declare function LastTradesSentiment(market?: string): number

-- Gets the main account leverage setting.
declare function Leverage(): number

-- Creates a line options object to be used for Plot().
declare function LineOptions(color?: string | EnumColor, style?: EnumCharting, deco?: EnumCharting, width?: number | HaasNumberCollection, offset?: number | HaasNumberCollection, side?: EnumCharting, id?: string, behind?: boolean, ignoreOnAxis?: boolean, drawTrailingLine?: boolean): any

-- Calculates the logarithm of a specified number.
declare function Ln(input1: number | number[] | HaasNumberCollection, input2?: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Loads a value saved on the specified key. When nothing is saved on the key, the default value is returned and saved on it; when the saved value cannot be read (e.g. the read timed out), the run ends and the next run tries again.
declare function Load(key: string, defaultValue?: any): any

-- Create a message in the log.
declare function Log(message: any | nil, color?: string | EnumColor): nil

-- Calculates the base 10 logarithm of a specified number.
declare function Log10(input: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Create an error message in the log.
declare function LogError(message: any): nil

-- Logs a warning and shows the bot as Insufficient funds for this update.
declare function LogWalletError(message: any): nil

-- Create a warning message in the log.
declare function LogWarning(message: any): nil

-- Gets the total amount open in a long position.
declare function LongAmount(market?: string): number

-- A collection with low prices. Sorted from new to old.
declare function LowPrices(interval?: number | HaasNumberCollection, fullCandles?: boolean, market?: string, hlcStyle?: boolean): HaasNumberCollection

-- The Moving Averages (MA) combines multiple Moving Averages
-- in one command. Works well together with the InputMaTypes() command. Supported types are:
-- 'sma', 'ema', 'dema', 'tema', 'trima', 't3', 'mama', 'kama' and 'wma'.
declare function MA(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection, maType: EnumMovingAverages): HaasNumberCollection

interface MACDResult { macd: HaasNumberCollection; signal: HaasNumberCollection; hist: HaasNumberCollection; 1: HaasNumberCollection; 2: HaasNumberCollection; 3: HaasNumberCollection; [index: number]: HaasNumberCollection }

-- The Moving Average Convergence Divergence (MACD), developed by ,
-- is a trend-following momentum indicator that shows the relationship between two moving averages of an asset's price.
-- The MACD is calculated by subtracting the longer-period Exponential Moving Average (EMA) from the shorter-period EMA.
declare function MACD(prices: number[] | HaasNumberCollection, fastPeriod: number | HaasNumberCollection, slowPeriod: number | HaasNumberCollection, signalPeriod: number | HaasNumberCollection): MACDResult

interface MACDEXTResult { macd: HaasNumberCollection; signal: HaasNumberCollection; hist: HaasNumberCollection; 1: HaasNumberCollection; 2: HaasNumberCollection; 3: HaasNumberCollection; [index: number]: HaasNumberCollection }

-- The Moving Average Convergence Divergence [Extended] (MACDEXT) is
-- the same as MACD, but provides more parameters to fiddle with.
declare function MACDEXT(prices: number[] | HaasNumberCollection, fastPeriod: number | HaasNumberCollection, fastType: EnumMovingAverages, slowPeriod: number | HaasNumberCollection, slowType: EnumMovingAverages, signalPeriod: number | HaasNumberCollection, signalType: EnumMovingAverages): MACDEXTResult

interface MACDFIXResult { macd: HaasNumberCollection; signal: HaasNumberCollection; hist: HaasNumberCollection; 1: HaasNumberCollection; 2: HaasNumberCollection; 3: HaasNumberCollection; [index: number]: HaasNumberCollection }

-- The Moving Average Convergence Divergence [Fixed] (MACDFIX) is
-- the same as MACD, but uses fixed periods for the fast (12) and slow (26) EMAs.
declare function MACDFIX(prices: number[] | HaasNumberCollection, signalPeriod: number | HaasNumberCollection): MACDFIXResult

interface MAMAResult { mama: HaasNumberCollection; fama: HaasNumberCollection; 1: HaasNumberCollection; 2: HaasNumberCollection; [index: number]: HaasNumberCollection }

-- The Mesa Adaptive Moving Average (MAMA) is a trend-following
-- indicator which adapts to price movement "based on the rate change of phase as measured by the Hilbert Transform Discriminator".
-- This method of adaptation features a fast and a slow moving average so that the composite moving average swiftly responds to price
-- changes and holds the average value until the next bar's close.
-- The Averages act as support and resistance areas and the price will tend to react to them.
-- This makes pullbacks to the MAMA and FAMA suitable with-trend entry areas. This indicator is usually plotted on the price chart.
-- NOTE: The FastLimit and SlowLimit parameters should be between 0.01 and 0.99.
declare function MAMA(prices: number[] | HaasNumberCollection, fastlimit: number | HaasNumberCollection, slowlimit: number | HaasNumberCollection): MAMAResult

-- The Moving Average Variable Period (MAVP) is a moving average
-- that adjusts itself based on the period settings given to it. The [inPeriods] array should be the
-- same length as [prices] array. The Nth period will be used to calculate the Nth data point.
-- It is essentially the same as changing the period yourself using the MA() command, but using this
-- command instead, you can use for example the absolute (ABS) CMO output values as the periods:
-- local periods = Abs(CMO(ClosePrices(), 20)).
declare function MAVP(prices: number[] | HaasNumberCollection, inPeriods: number[] | HaasNumberCollection, minPeriod: number | HaasNumberCollection, maxPeriod: number | HaasNumberCollection, maType?: EnumMovingAverages): HaasNumberCollection

-- Max Index (MAXINDEX) will return the index of the
-- highest high in source data within the given period. You can see this index as the "distance"
-- to the highest high. To get the highest high value, use this index with the input
-- array or use GetHigh/GetHighs command instead.
declare function MAXINDEX(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): number

-- Median Price (MEDPRICE) indicator is simply the midpoint of market's prices.
-- The Typical Price and Weighted Close are similar indicators. The Median Price indicator
-- provides a simple, single-line chart of the market's"average price."
-- This average price is useful when you want a simpler view of prices.
-- This indicator is usually plotted on the price chart.
declare function MEDPRICE(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection): HaasNumberCollection

-- The Money Flow Index (MFI), developed by Gene Quong and Avrum Soudack,
-- is an oscillator that uses both price and volume to measure buying and selling pressure.
-- MFI is also known as volume-weighted RSI. MFI starts with the typical price for each period.
-- Money flow is positive when the typical price rises (buying pressure) and negative when the
-- typical price declines (selling pressure). A ratio of positive and negative money flow is
-- then plugged into an RSI formula to create an oscillator that moves between zero and one hundred.
-- As a momentum oscillator tied to volume, MFI is best suited to identify reversals and price
-- extremes with a variety of signals.
declare function MFI(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, close: number[] | HaasNumberCollection, volume: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- Midpoint price (MIDPOINT) is similar to the
-- Midprice (MIDPRICE), except the highest and lowest values are returned from
-- the same input field; the source data. Midpoint indicator calculates the highest
-- close and lowest close within the look back period and averages
-- the two values.
declare function MIDPOINT(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- MidPrice (MIDPRICE) returns the midpoint value from
-- two different input fields. The Midprice indicator calculates the
-- highest high and lowest low within the look back period and averages
-- the two values to return the Midprice.
declare function MIDPRICE(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- Min Index (MININDEX) will return the index of the
-- lowest low in source data within the given period. You can see this index as the "distance"
-- to the lowest low. To get the lowest low value, use this index with the input
-- array or use GetLow/GetLows command instead.
declare function MININDEX(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): number

-- The Negative Directional indicator (MINUSDI) measures the presence of a
-- downtrend and is part of the Average Directional Index (ADX). If -DI is sloping upward, it's a sign
-- that the price downtrend is getting stronger. This indicator is nearly always plotted along with
-- the Positive Directional indicator (PLUSDI).
declare function MINUSDI(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, close: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- The Negative Directional Movement (MINUSDM) indicator is the basis of
-- the Negative Directional indicator (MINUSDI).
declare function MINUSDM(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- The Momentum Indicator (MOM) is a leading indicator measuring a
-- asset's rate-of-change. It compares the current price with the previous price from a number
-- of periods ago. The ongoing plot forms an oscillator that moves above and below 0.
-- This indicator is usually plotted on its own chart.
declare function MOM(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- Gets makers fee of the market.
declare function MakersFee(market?: string): number

-- Converts the signal if its matches the defined one.
declare function MapSignal(signal: Enum, signalToCovert: EnumSignal, convertedSignal: EnumSignal): EnumSignal

-- Convert margin to a trade amount. In spot markets, the margin is anticipated to be in the quote currency (e.g., USDT in BTC/USDT). For leverage markets, the margin is expected to be in the underlying currency.
declare function MarginToTradeAmount(price: number | HaasNumberCollection, margin: number | HaasNumberCollection, leverage: number | HaasNumberCollection, market?: string): number

-- Changes the color of a single candle.
declare function MarkCandle(chartId: number | HaasNumberCollection, depth?: number | HaasNumberCollection): nil

-- Gets the market type enumeration of the market.
declare function MarketType(market?: string): EnumTrading

-- Returns the maximum value. If the input is a single array, it returns the biggest number in that array (single value). If inputs are both numbers, it returns the biggest number (single value). If inputs are array and number, it returns the biggest number (array[1] vs number, single value). If inputs are both arrays, it returns an array of the biggest numbers per cell (array, length determined by the shorter array).
declare function Max(...: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Calculates the maximum amount which can be used to place an exit long order based on wallet data. Assets reserved in open orders are excluded by default.
declare function MaxExitLongAmount(market?: string): number

-- Calculates the maximum amount which can be used to place an exit short order based on wallet data. Assets reserved in open orders are excluded by default.
declare function MaxExitShortAmount(market?: string): number

-- Calculates the maximum amount which can be used to place a long order based on wallet data.
declare function MaxLongAmount(market?: string): number

-- Calculates the maximum amount which can be used to place a short order based on wallet data.
declare function MaxShortAmount(market?: string): number

-- Returns the minimum value. If the input is a single array, it returns the minimum in that array (single value). If inputs are both numbers, it returns the smallest number (single value). If inputs are array and number, it returns the smallest number (single value). If inputs are both arrays, it returns an array of the smallest numbers per cell (array, length determined by shortest array)
declare function Min(...: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Calculates the minimum trade amount on a certain price while keeping exchange specifications in consideration.
declare function MinimumTradeAmount(market?: string, price?: number | HaasNumberCollection): number

-- Calculates the number of minutes before a new candle opens.
declare function MinutesTillCandleClose(interval: number | HaasNumberCollection): number

-- Multiplies input1 with input2. If one of the parameters is a single value, the other is multiplied by this.
declare function Mul(input1: number | number[] | HaasNumberCollection, input2: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Multiplies input1 with input2. If one of the parameters is a single value, the other is multiplied by this.
declare function Mult(input1: number | number[] | HaasNumberCollection, input2: number | number[] | HaasNumberCollection): HaasNumberCollection

-- The Normalized Average True Range (NATR) is the normalized version
-- of the Average True Range (ATR) indicator.
declare function NATR(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, close: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- Blocks enter trade when targetPrice is above the last sell order. Only works on spot and when there is no position open.
declare function NeverEnterWithALoss(acceptedLoss?: number | HaasNumberCollection, targetPrice?: number | HaasNumberCollection): boolean

-- Compares the average enter price to the targetPrice or current price.
declare function NeverExitWithLoss(acceptedLoss?: number | HaasNumberCollection, targetPrice?: number | HaasNumberCollection, positionId?: string): boolean

-- Creates an unique identifier.
declare function NewGuid(): string

-- Validates all values on being false.
declare function Not(...: boolean): boolean

-- Compares two values and returns whether or not the values are different.
declare function NotEquals(value1: any, value2: any): boolean

-- The On-Balance Volume (OBV), developed by Joseph Granville,
-- is a momentum indicator that uses volume flow to predict changes in asset price.
-- He believed that when volume increases sharply without a significant change in the asset's price,
-- the price will eventually jump upward or fall downward.
-- This indicator is usually plotted on its own chart.
declare function OBV(prices: number[] | HaasNumberCollection, volumes: number[] | HaasNumberCollection): HaasNumberCollection

-- A collection with an average of open and close prices. Sorted from new to old.
declare function OCPrices(interval?: number | HaasNumberCollection, fullCandles?: boolean, market?: string, hlcStyle?: boolean): HaasNumberCollection

-- A collection with the average of open, high, low and close prices. Sorted from new to old.
declare function OHLCPrices(interval?: number | HaasNumberCollection, fullCandles?: boolean, market?: string, hlcStyle?: boolean): HaasNumberCollection

-- A collection with open prices. Sorted from new to old.
declare function OpenPrices(interval?: number | HaasNumberCollection, fullCandles?: boolean, market?: string, hlcStyle?: boolean): HaasNumberCollection

-- Converts a timestamp to the open timestamp of its candle.
declare function OpenTime(unix: number | HaasNumberCollection, interval: number | HaasNumberCollection): number

-- Validates if any of the values is true.
declare function Or(...: boolean): boolean

interface OrderContainerResult { price: number; executedAmount: number; filledAmount: number; isOpen: boolean; isFilled: boolean; isCancelled: boolean; feeCosts: number; feeCurrency: number; openTime: number; positionId: string; orderId: string; isEnterOrder: boolean; isExitOrder: boolean; triggerPrice: number; isBuyOrder: boolean; isSellOrder: boolean; 1: number; 2: number; 3: number; 4: boolean; 5: boolean; 6: boolean; 7: number; 8: number; 9: number; 10: string; 11: string; 12: boolean; 13: boolean; 14: number; 15: boolean; 16: boolean; [index: number]: boolean | number | string }

-- Gets all the information from an specific order.
declare function OrderContainer(orderId: string): OrderContainerResult

-- Only allows an order to occur once per bar. Signals produced during an ordered bar are blocked.
declare function OrderOncePerBar(interval?: number | HaasNumberCollection, positionId?: string): boolean

-- Calculates the orderbook sentiment as a number.
declare function OrderbookSentiment(market?: string): number

-- Calculates the target profit and makes sure the fee costs are double-covered.
declare function OvercomeDoubleFeeCosts(targetPrice?: number | HaasNumberCollection, positionId?: string): boolean

-- Calculates the target profit and makes sure the fee costs are covered.
declare function OvercomeFeeCosts(targetPrice?: number | HaasNumberCollection, positionId?: string): boolean

-- The Positive Directional indicator (PLUSDI) measures the presence of an
-- uptrend and is part of the Average Directional Index (ADX). If +DI is sloping upward, it's a sign
-- that the price uptrend is getting stronger. This indicator is nearly always plotted along with
-- the Negative Directional indicator (MINUSDI).
declare function PLUSDI(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, close: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- The Positive Directional Movement (PLUSDM) indicator is the basis of
-- the Negative Directional indicator (PLUSDI).
declare function PLUSDM(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- The Percentage Price Oscillator (PPO) is a momentum oscillator
-- that measures the difference between two moving averages as a percentage of the larger
-- moving average. As with its cousin, MACD, the Percentage Price Oscillator is shown with
-- a signal line, a histogram and a centerline.
declare function PPO(prices: number[] | HaasNumberCollection, fastPeriod: number | HaasNumberCollection, slowPeriod: number | HaasNumberCollection, maType: EnumMovingAverages): HaasNumberCollection

-- Converts the value to a specific type.
declare function Parse(value: any, type: EnumParameterType): any

-- Parses CSV data string and returns it as an object. Downloading from a URL is only supported on self-hosted servers.
declare function ParseCsv(csv: string, hasHeaders?: boolean, columnDelimiter?: string, rowDelimiter?: string): any

-- Parses a JSON data string (an object, an array or a single value) and returns it as an object. Downloading from a URL is only supported on self-hosted servers. Invalid JSON logs a warning and returns nil.
declare function ParseJson(json: string): any

-- Parses the trade amount to exchange specifications.
declare function ParseTradeAmount(market: string, price: number | HaasNumberCollection, amount: number | HaasNumberCollection): number

-- Parses the trade price to exchange specifications.
declare function ParseTradePrice(market: string, price: number | HaasNumberCollection): number

-- Enables the paused flag. Use in combination with IsBotPaused() to read the value. Can be used to temporary block certain actions like increasing position without stopping the whole bot. Bots will continue to update and are allowed to place/cancel orders.
declare function PauseBot(): nil

-- Calculates the percentage between input1 and input2 or the percentage change between the values of input1.
declare function PercentageChange(input1: number | number[] | HaasNumberCollection, input2?: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Compares the average enter price to current price, percentage-based.
declare function PercentagePriceChange(percentage?: number | HaasNumberCollection, targetPrice?: number | HaasNumberCollection, positionId?: string): boolean

-- Places a (limit) buy order for the given amount and price. Returns the order identifier (text).
declare function PlaceBuyOrder(price: number | HaasNumberCollection, amount: number | HaasNumberCollection, market?: string, type?: EnumOrderTypes, note?: string, positionId?: string, timeout?: number | HaasNumberCollection, triggerPrice?: number | HaasNumberCollection, reduceOnly?: boolean, hiddenOrder?: boolean): string

-- Executes the remaining amount of a canceled order.
declare function PlaceCancelledOrder(orderId: string, price?: number | HaasNumberCollection): string

-- Places a (limit) exit long order for the given amount and price. Returns the order identifier (text).
declare function PlaceExitLongOrder(price: number | HaasNumberCollection, amount: number | HaasNumberCollection, market?: string, type?: EnumOrderTypes, note?: string, positionId?: string, timeout?: number | HaasNumberCollection, triggerPrice?: number | HaasNumberCollection, reduceOnly?: boolean, hiddenOrder?: boolean): string

-- Places exit orders for a specific bot position.
declare function PlaceExitPositionOrder(positionId?: string, price?: number | HaasNumberCollection, type?: EnumOrderTypes, note?: string, timeout?: number | HaasNumberCollection): string

-- Places a (limit) exit short order for the given amount and price. Returns the order identifier (text).
declare function PlaceExitShortOrder(price: number | HaasNumberCollection, amount: number | HaasNumberCollection, market?: string, type?: EnumOrderTypes, note?: string, positionId?: string, timeout?: number | HaasNumberCollection, triggerPrice?: number | HaasNumberCollection, reduceOnly?: boolean, hiddenOrder?: boolean): string

-- Places a (limit) go long order for the given amount and price. Returns the order identifier (text).
declare function PlaceGoLongOrder(price: number | HaasNumberCollection, amount: number | HaasNumberCollection, market?: string, type?: EnumOrderTypes, note?: string, positionId?: string, timeout?: number | HaasNumberCollection, triggerPrice?: number | HaasNumberCollection, reduceOnly?: boolean, hiddenOrder?: boolean): string

-- Places a (limit) go short order for the given amount and price. Returns the order identifier (text).
declare function PlaceGoShortOrder(price: number | HaasNumberCollection, amount: number | HaasNumberCollection, market?: string, type?: EnumOrderTypes, note?: string, positionId?: string, timeout?: number | HaasNumberCollection, triggerPrice?: number | HaasNumberCollection, reduceOnly?: boolean, hiddenOrder?: boolean): string

-- Places a (limit) sell order for the given amount and price. Returns the order identifier (text).
declare function PlaceSellOrder(price: number | HaasNumberCollection, amount: number | HaasNumberCollection, market?: string, type?: EnumOrderTypes, note?: string, positionId?: string, timeout?: number | HaasNumberCollection, triggerPrice?: number | HaasNumberCollection, reduceOnly?: boolean, hiddenOrder?: boolean): string

-- Creates a data line on the chart. The line can be styled accordingly. A positive chartId will place the line below the main price chart. A negative index above.
declare function Plot(chartId: number | HaasNumberCollection, lineName: string, value: number | number[] | HaasNumberCollection, colorOptions?: any): string

-- Takes care of the plotting side of a BBANDS (like) calculation and chart.
declare function PlotBBandsChart(chartIndex: number | HaasNumberCollection, name: string, upper: number | number[] | HaasNumberCollection, middle: number | number[] | HaasNumberCollection, lower?: number | number[] | HaasNumberCollection): nil

-- Creates a band between 2 lines.
declare function PlotBands(lineGuid1: string, lineGuid2: string, fillColor: string | EnumColor): nil

-- Changes a line to bars.
declare function PlotBars(lineGuid: string, baseValue?: number | HaasNumberCollection, fillColor?: string | EnumColor): nil

-- Draws a horizontal zone with buy and sell lines on the chart.
declare function PlotBuySellZone(chartId: number | HaasNumberCollection, start: number | HaasNumberCollection, end_: number | HaasNumberCollection): nil

-- Changes the line into circles.
declare function PlotCircle(lineGuid: string, fillColor?: string | EnumColor): nil

-- Creates a cloud with double colors between 2 lines.
declare function PlotCloud(lineGuid1: string, lineGuid2: string, opacity: number | HaasNumberCollection): nil

-- Changes the color of the line based on a base value.
declare function PlotDoubleColor(lineGuid: string, baseValue: number | HaasNumberCollection, secondColor: string | EnumColor, fillColor?: string | EnumColor): nil

-- Change the line into a histogram.
declare function PlotHistogram(lineGuid: string, secondColor: string | EnumColor, fillRaisingBars?: boolean): nil

-- Takes care of the plotting side of a MACD (like) calculation and chart.
declare function PlotHistogramSignals(chartIndex: number | HaasNumberCollection, name: string, histogram: number | number[] | HaasNumberCollection, shortSignal?: number | number[] | HaasNumberCollection, longSignal?: number | number[] | HaasNumberCollection): nil

-- Draws a horizontal line on the chart.
declare function PlotHorizontalLine(chartId: number | HaasNumberCollection, name: string, color: string | EnumColor, value: number | HaasNumberCollection, lineDecoration?: EnumCharting, side?: EnumCharting): nil

-- Draws a horizontal zone on the chart.
declare function PlotHorizontalZone(chartId: number | HaasNumberCollection, name: string, color: string | EnumColor, start: number | HaasNumberCollection, end_: number | HaasNumberCollection, side?: EnumCharting): nil

-- Plots the line with a buy and sell zone on the chart.
declare function PlotLineBuySellZone(chartIndex: number | HaasNumberCollection, name: string, source: number | number[] | HaasNumberCollection, start: number | HaasNumberCollection, end_: number | HaasNumberCollection): nil

-- Plots a pivot cross above or below the chart when detected.
declare function PlotPivot(leftStrength: number | HaasNumberCollection, rightStrength: number | HaasNumberCollection): nil

-- Creates a price plot. Candlestick by default.
declare function PlotPrice(chartId: number | HaasNumberCollection, market: string, interval?: number | HaasNumberCollection, style?: EnumCharting, upColor?: string | EnumColor, upFill?: boolean, downColor?: string | EnumColor, downFill?: boolean, markColor?: string | EnumColor, markFill?: boolean): nil

-- Draws a shape above the candle or first line on the chart.
declare function PlotShape(chartId?: number | HaasNumberCollection, shape?: EnumCharting, color?: string | EnumColor, size?: number | HaasNumberCollection, aboveCandle?: boolean, text?: string, textColor?: string | EnumColor, offset?: number | HaasNumberCollection): nil

-- Changes the line into a specific shape.
declare function PlotShapes(lineGuid: string, shape: EnumCharting, fillColor?: string | EnumColor): nil

-- Creates a small signal bar chart. A positive chartId will place the line below the main price chart. A negative index above.
declare function PlotSignalBar(chartId: number | HaasNumberCollection, color: string | EnumColor): nil

-- Creates a stacked area chart from a line guid collection.
declare function PlotStackedArea(lineGuids: any): nil

-- Draws a vertical line on the chart.
declare function PlotVerticalLine(chartId: number | HaasNumberCollection, name: string, color: string | EnumColor, unix: number | HaasNumberCollection, lineDecoration?: EnumCharting): nil

-- Draws a vertical zone on the chart.
declare function PlotVerticalZone(chartId: number | HaasNumberCollection, name: string, color: string | EnumColor, start: number | HaasNumberCollection, end_: number | HaasNumberCollection): nil

-- Creates volume bars. The bars can be styles accordingly. A positive chartId will place the line below the main price chart. A negative index above.
declare function PlotVolume(chartId: number | HaasNumberCollection, upColor?: string | EnumColor, downColor?: string | EnumColor, upFill?: boolean, downFill?: boolean, side?: EnumCharting): nil

interface PositionContainerResult { positionId: string; market: string; isLong: boolean; isShort: boolean; enterPrice: number; amount: number; profit: number; roi: number; openTime: number; updatedTime: number; closeTime: number; direction: EnumPosition; 1: string; 2: string; 3: boolean; 4: boolean; 5: number; 6: number; 7: number; 8: number; 9: number; 10: number; 11: number; 12: EnumPosition; [index: number]: EnumPosition | boolean | number | string }

-- Gets all the information from the open bot position.
declare function PositionContainer(positionId?: string): PositionContainerResult

interface PositionToBoolResult { isLong: boolean; isShort: boolean; isNone: boolean; 1: boolean; 2: boolean; 3: boolean; [index: number]: boolean }

-- Converts a position value to 3 boolean values.
declare function PositionToBool(position: EnumPosition): PositionToBoolResult

-- Calculates a specified number/table raised to the specified power number/table.
declare function Pow(value: number | number[] | HaasNumberCollection, power: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Returns a number of how many decimals is allowed for order prices.
declare function PriceDecimals(market?: string, price?: number | HaasNumberCollection): number

-- Determines the price level. For example. 123456 will return 10000. 123 will return 100.
declare function PriceLevel(price: number | HaasNumberCollection): number

-- Gets the main market of the bot.
declare function PriceMarket(): string

-- Returns the minimum allowed price step for market.
declare function PriceStep(market?: string): number

-- A collection with close prices. Sorted from new to old.
declare function Prices(interval?: number | HaasNumberCollection, fullCandles?: boolean, market?: string, hlcStyle?: boolean): HaasNumberCollection

-- Returns the profit label. For reflection, in case the market is Bitstamp BTC/USD it will return 'USD'. When we are on BitMEX XBT/USD (XBTUSD), it will return 'XBT'.
declare function ProfitCurrency(market?: string): string

-- Returns the profit label. For reflection, in case the market is Bitstamp BTC/USD it will return 'USD'. When we are on BitMEX XBT/USD (XBTUSD), it will return 'XBT'.
declare function ProfitLabel(market?: string): string

-- Returns the quote currency of the market. For reflection, in case we are on Bitstamp BTC/USD it will return 'USD'.
declare function QuoteCurrency(market?: string): string

-- Returns a number of how many decimals is allowed for order prices.
declare function QuoteDecimals(market?: string, price?: number | HaasNumberCollection): number

-- Returns the minimum allowed price step for market.
declare function QuoteStep(market?: string): number

-- The Rate-of-Change (ROC) is often used when speaking about momentum,
-- and it can generally be expressed as a ratio between a change in one variable relative to a
-- corresponding change in another; graphically, the rate of change is represented by the slope
-- of a line. The ROC is often illustrated by the Greek letter delta.
-- This indicator is usually plotted on its own chart.
declare function ROC(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- The Rate-of-Change Percentage (ROCP) is an alternative for ROC,
-- showing the values as percentages rather than absolutes. This indicator is usually plotted on its own chart.
declare function ROCP(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- The Rate-of-Change Ratio (ROCR) is an alternative for ROC,
-- showing the values as a ratio rather than absolutes. This indicator is usually plotted on its own chart.
declare function ROCR(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- The Rate-of-Change Ratio 100 Scale (ROCR100) is an alternative for ROC,
-- showing the values as a ratio rather than absolutes. This indicator is usually plotted on its own chart.
declare function ROCR100(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- The Relative Strength Index (RSI), developed by J. Welles Wilder,
-- is a momentum oscillator that measures the speed and change of price movements.
-- The RSI oscillates between zero and 100. Traditionally the RSI is considered
-- overbought when above 70 and oversold when below 30, but can also be used to confirm
-- trends. This indicator is usually plotted on its own chart.
declare function RSI(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- The Relative Strength Index (RSI_ALTB), developed by J. Welles Wilder,
-- is a momentum oscillator that measures the speed and change of price movements.
-- The RSI oscillates between zero and 100. Traditionally the RSI is considered
-- overbought when above 70 and oversold when below 30, but can also be used to confirm
-- trends. This indicator is usually plotted on its own chart.
declare function RSI_ALTB(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- Replaces any value above a specific value with another value.
declare function ReplaceAbove(input: number | number[] | HaasNumberCollection, threshold: number | HaasNumberCollection, newValue: number | HaasNumberCollection): HaasNumberCollection

-- Replaces any value below a specific value with another value.
declare function ReplaceBelow(input: number | number[] | HaasNumberCollection, threshold: number | HaasNumberCollection, newValue: number | HaasNumberCollection): HaasNumberCollection

-- Disables the pause flag. Use in combination with IsBotPaused() to read the value.
declare function ResumeBot(): nil

-- Reverses a signal from long to short or short to long. SignalNone will be ignored and stay the same.
declare function ReverseSignal(signal: Enum): EnumSignal

-- Rounds a value (or values if table) to the nearest integer or to the specified number of fractional digits.
declare function Round(input: number | number[] | HaasNumberCollection, digits: number | HaasNumberCollection): HaasNumberCollection

-- The Parabolic Stop-And-Reverse (SAR), developed by Welles Wilder,
-- refers to a price-and-time-based trading system. Wilder called this the "Parabolic Time/Price System."
-- SAR stands for "stop and reverse", which is the actual indicator used in the system.
-- SAR trails price as the trend extends over time. The indicator is below prices as they're rising
-- and above prices as they're falling. In this regard, the indicator stops and reverses when the price
-- trend reverses and breaks above or below the indicator.
-- This indicator is usually plotted on the price chart.
declare function SAR(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, acceleration: number | HaasNumberCollection, maxSpeed: number | HaasNumberCollection): HaasNumberCollection

-- The Parabolic Stop-And-Reverse [Extended] (SAREXT) is the same indicator as SAR(),
-- but opens up more parameters for the user to modify.
declare function SAREXT(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, startValue: number | HaasNumberCollection, offsetOnReverse: number | HaasNumberCollection, accelInitLong: number | HaasNumberCollection, accelLong: number | HaasNumberCollection, accelMaxLong: number | HaasNumberCollection, accelInitShort: number | HaasNumberCollection, accelShort: number | HaasNumberCollection, accelMaxShort: number | HaasNumberCollection): HaasNumberCollection

-- The Simple Moving Average (SMA) is an arithmetic moving average
-- calculated by adding recent closing prices and then dividing that by the number of time
-- periods in the calculation average.
-- This indicator is usually plotted on the price chart.
declare function SMA(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- The Simple Moving Average (SMA2) is an arithmetic moving average
-- calculated by adding recent closing prices and then dividing that by the number of time
-- periods in the calculation average.
-- This indicator is usually plotted on the price chart.
declare function SMA2(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- The Simple Stochastic (SSTOCH)
declare function SSTOCH(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- The Standard Deviation (STDDEV) is an indicator that measures
-- the size of recent price moves of an asset, to predict how volatile the price may be in
-- future. It can help you decide whether the volatility of the price is likely to increase
-- or decrease.
-- This indicator is usually plotted on its own chart.
declare function STDDEV(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection, deviation: number | HaasNumberCollection): HaasNumberCollection

interface STOCHResult { slowK: HaasNumberCollection; slowD: HaasNumberCollection; 1: HaasNumberCollection; 2: HaasNumberCollection; [index: number]: HaasNumberCollection }

-- The Stochastic Oscillator [Full] (STOCH), developed by Dr. George Lane,
-- is a momentum indicator that uses support and resistance levels. The term stochastic
-- refers to the point of a current price in relation to its price range over a period of time.
declare function STOCH(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, close: number[] | HaasNumberCollection, fastK: number | HaasNumberCollection, slowK: number | HaasNumberCollection, slowD: number | HaasNumberCollection): STOCHResult

interface STOCHFResult { fastK: HaasNumberCollection; fastD: HaasNumberCollection; 1: HaasNumberCollection; 2: HaasNumberCollection; [index: number]: HaasNumberCollection }

-- The Stochastic Oscillator [Fast] (STOCHF).
declare function STOCHF(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, close: number[] | HaasNumberCollection, fastK: number | HaasNumberCollection, fastD: number | HaasNumberCollection, maType: EnumMovingAverages): STOCHFResult

interface STOCHRSIResult { fastK: HaasNumberCollection; fastD: HaasNumberCollection; 1: HaasNumberCollection; 2: HaasNumberCollection; [index: number]: HaasNumberCollection }

-- The Stochastic-RSI (STOCHRSI) is essentially an indicator of an indicator.
-- The Stochastic RSI is an oscillator that calculates a value between 0 and 1 which is
-- then plotted as a line. This indicator is primarily used for identifying overbought and oversold conditions.
-- This indicator is usually plotted on its own chart.
declare function STOCHRSI(prices: number[] | HaasNumberCollection, rsiPeriod: number | HaasNumberCollection, fastK: number | HaasNumberCollection, fastD: number | HaasNumberCollection, maType: EnumMovingAverages): STOCHRSIResult

-- Checks a collection for active safety signals.
declare function SafetyContainer(...: boolean): boolean

-- Saves a value on a specific key. This value can be retrieved with Load(). A maximum of 10.000 keys can be stored.
declare function Save(key: string, value: any): nil

-- This command can save and distribute a trading signal over the HaasCloud. This can be used in combination with trade signal enumeration. For example SignalLong(), SignalShort(), SignalExitPosition() or SignalNone(). Only publishes from a running bot. In backtests, labs and the editor's compile pass it does nothing.
declare function SaveRemoteSignal(id: string, secret: string, signal: EnumSignal): nil

-- Calculates the Standard Deviation from the data series.
declare function Sd(input: number[] | HaasNumberCollection): number

-- A collection with sell/ask prices. Sorted from new to old.
declare function SellPrices(interval?: number | HaasNumberCollection, fullCandles?: boolean, market?: string, hlcStyle?: boolean): HaasNumberCollection

-- Sends a notification to your browser and configured push channels (Discord, Telegram). Has no effect during backtests.
declare function SendNotification(title: string, message: string): nil

-- Sets a custom base value used in the ROI calculation (realized profits / baseValue * 100).
declare function SetBotRoiBaseValue(baseValue: number | HaasNumberCollection, market?: string): nil

-- Sets a custom fee percentage for backtests: the backtest charges it as both the maker and the taker fee, and Fee(), MakersFee() and TakersFee() return it. It has no effect on live or paper trading, which use the exchange's fees.
declare function SetFee(percentage: number | HaasNumberCollection, market?: string): nil

-- Sets the leverage ratio for current or specified market.
declare function SetLeverage(leverage: number | HaasNumberCollection, market?: string, accountId?: string): boolean

-- Sets the margin mode for current or specific market. It is NOT possible to change margin mode while having an open position.
declare function SetMarginMode(marginMode: EnumMarginMode, market?: string, accountId?: string): boolean

-- Overwrites the order type with the given type. This can be used to execute different order types on managed trading. Only LimitOrderType, MarketOrderType, NoTimeOutOrderType and MakerOrCancelOrderType are accepted. The conditional types (StopLimitOrderType, StopMarketOrderType, TakeProfitLimitOrderType, TakeProfitMarketOrderType, and the 'Trailing stop market order' choice of InputOrderType) need a triggerPrice, so use them with the Place*Order commands instead: SetOrderType() refuses them with a warning and keeps the current order type.
declare function SetOrderType(type: EnumOrderTypes): nil

-- Sets the position mode for current or specified market. It is NOT possible to change position mode while having an open position.
declare function SetPositionMode(positionMode: EnumPositionMode, accountId?: string, market?: string): boolean

-- Configures the opacity for the stacked areas of a chart, as a value between 0 and 100.
declare function SetStackedAreaOpacity(chartId: number | HaasNumberCollection, opacity: number | HaasNumberCollection): nil

-- Gets the total amount open in a short position.
declare function ShortAmount(market?: string): number

-- Keeps track of the highest/lowest recorded price and adjust the stop loss accordingly. The higher the price change the more the trailing distances shrinks.
declare function ShrinkingTrailingStopLoss(percentage: number | HaasNumberCollection, shrinkPercentage: number | HaasNumberCollection, positionId?: string, direction?: EnumPosition): boolean

-- Calculates an integer that indicates the sign of a number.
declare function Sign(input: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Maps a signal value to their defined specifications.
declare function SignalMapper(signal: Enum, reverse?: boolean, mapLongTo?: EnumSignal, mapShortTo?: EnumSignal, mapExitTo?: EnumSignal, mapNoneTo?: EnumSignal): EnumSignal

-- Sets properties such as weight or ignore in the signal input.
declare function SignalProperties(signal: Enum, useLong?: boolean, useShort?: boolean, useExit?: boolean, weight?: number | HaasNumberCollection, delay?: number | HaasNumberCollection): EnumSignal

interface SignalToBoolResult { isLong: boolean; isShort: boolean; isExit: boolean; isNone: boolean; 1: boolean; 2: boolean; 3: boolean; 4: boolean; [index: number]: boolean }

-- Converts a signal value to 4 boolean values.
declare function SignalToBool(signal: Enum): SignalToBoolResult

-- Logs the given signals.
declare function SignalToLog(...: Enum): nil

-- Add a weight to the signal. Can be used in combination with GetWeightedConsensusSignal().
declare function SignalWeight(signal: Enum, weight: number | HaasNumberCollection): EnumSignal

-- Reads the given data and tries to give a forecast.
declare function SimpleForecastBySsa(dataset: number[] | HaasNumberCollection, l: number | HaasNumberCollection, n: number | HaasNumberCollection, forecastCount: number | HaasNumberCollection): HaasNumberCollection

-- Calculates the sine of the specified angle.
declare function Sin(input: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Calculates the hyperbolic sine of the specified angle.
declare function Sinh(input: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Pauses script execution for a specified number of milliseconds. Useful for adding random delays to avoid predictable order timing patterns.
declare function Sleep(milliseconds: number | HaasNumberCollection): number

interface SlowRSIResult { rsi: HaasNumberCollection; slowRsi: HaasNumberCollection; 1: HaasNumberCollection; 2: HaasNumberCollection; [index: number]: HaasNumberCollection }

-- The SlowRSI is a custom implementation from Haasonline. It uses a custom RSI and EMA calculation.
declare function SlowRSI(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection, signal: number | HaasNumberCollection): SlowRSIResult

-- Stores numeric values in a collection. Only adds the new value when the candle on the specified interval closed. This results in interval based data.
declare function SourceManager(newValue: number | HaasNumberCollection, interval?: number | HaasNumberCollection, cap?: number | HaasNumberCollection, initialValues?: number[] | HaasNumberCollection): HaasNumberCollection

-- Gets the price source based on the input enum given. Can be any of Enumerations Source Price Types.
declare function SourcePrices(sourceType: EnumSourcePriceTypes, interval?: number | HaasNumberCollection, fullCandles?: boolean, market?: string, hlcStyle?: boolean): HaasNumberCollection

-- Calculates the square root of a specified number.
declare function Sqrt(input: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Starts a timer.
declare function StartTimer(key?: string): nil

-- Calculates the current percentage change from the average enter price and compares it with the stop loss value.
declare function StopLoss(percentage: number | HaasNumberCollection, positionId?: string, direction?: EnumPosition): boolean

-- Blocks any signal until a certain number of minutes have passed since the last exit trade executed by a safety.
declare function StopLossCooldown(minutes: number | HaasNumberCollection, positionId?: string): boolean

-- Calculates the defined position's current ROI percentage and gives a signal if the set loss is reached.
declare function StopLossROI(percentage: number | HaasNumberCollection, positionId?: string, direction?: EnumPosition): boolean

-- Stops a timer.
declare function StopTimer(key?: string): number

-- Returns a value indicating whether a specified substring occurs within this string.
declare function StringContains(value: string, searchValue: string, ignoreCase?: boolean): boolean

-- Splits a string into substrings that are based on the characters in an array.
declare function StringExplode(value: string, delimiter: string): any

-- Split a string on '&' and '='.
declare function StringFromQuery(value: string): any

-- Gets the zero-based index of the first occurrence of the specified string in the current.
declare function StringIndexOf(value: string, searchValue: string, ignoreCase?: boolean): number

-- Concatenates 2 string with an optional separator.
declare function StringJoin(value1: any, value2: any, separator?: string): string

-- Splits a string into substrings that are based on the characters in an array.
declare function StringSplit(value: string, delimiter: string): any

-- Subtracts numbers/tables and returns the result number/table.
declare function Sub(input1: number | number[] | HaasNumberCollection, input2: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Subtracts a percentage to the value.
declare function SubPerc(value: number | number[] | HaasNumberCollection, percentage: number | HaasNumberCollection): HaasNumberCollection

-- Subtracts a percentage to the value.
declare function SubPercentage(value: number | number[] | HaasNumberCollection, percentage: number | HaasNumberCollection): HaasNumberCollection

-- Retrieves a substring from this instance. The substring starts at a specified character position and has a specified length.
declare function SubString(value: string, start: number | HaasNumberCollection, length: number | HaasNumberCollection): string

-- Adds numbers/tables and returns the result number/table.
declare function Sum(input1: number | number[] | HaasNumberCollection, input2?: number | number[] | HaasNumberCollection): HaasNumberCollection

-- The Triple Exponential Moving Average (T3), developed by Tim Tillson,
-- attempts to offers a moving average with better smoothing than traditional exponential moving average.
-- This indicator is usually plotted on the price chart.
declare function T3(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection, vFactor: number | HaasNumberCollection): HaasNumberCollection

-- The Triple Exponential Moving Average (TEMA), developed by Patrick Mulloy,
-- offers a moving average with less lag then traditional exponential moving average.
-- This indicator is usually plotted on the price chart.
declare function TEMA(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- The True Range (TRANGE) developed by J. Welles Wilder,
-- is a technical analysis volatility indicator. The indicator does not provide an
-- indication of price trend, simply the degree of price volatility.
-- This indicator is usually plotted on its own chart.
declare function TRANGE(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, close: number[] | HaasNumberCollection): HaasNumberCollection

-- The Triangular Moving Average (TRIMA) is similar to other
-- moving averages in that it shows the average (or mean) price over a specified number
-- of data points (usually a number of price bars). However, the triangular moving average
-- differs in that it is double smoothed - which also means it is averaged twice.
-- This indicator is usually plotted on the price chart.
declare function TRIMA(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- TRIX is a momentum oscillator that displays the percent rate of change of a triple exponentially smoothed moving average.
-- This indicator is usually plotted on its own chart.
declare function TRIX(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- Time Series Forecast (TSF) is a linear
-- regression calculation that plots each bar's current regression
-- value using the least square fit method. This indicator is sometimes
-- referred to as a moving linear regression similar to a moving average.
-- For example, the TSF value that covers 10 days will have the same
-- value as a 10-day Time Series Forecast. This differs slightly from
-- the Linear Regression indicator in that the Linear Regression indicator
-- does not add the slope to the ending value of the regression line.
-- This indicator is usually plotted on the price chart.
declare function TSF(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- The True Strength Index (TSI) is a momentum oscillator based on a double smoothing of price changes.
declare function TSI(prices: number[] | HaasNumberCollection, periodA: number | HaasNumberCollection, periodB: number | HaasNumberCollection): HaasNumberCollection

-- Typical Price (TYPPRICE) is simply an average of asset's price.
-- The Median Price (MEDPRICE) and Weighted Close Price (WCLPRICE) are similar indicators.
-- The Typical Price indicator provides a simple, single-line plot of the asset's average price.
declare function TYPPRICE(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, close: number[] | HaasNumberCollection): HaasNumberCollection

-- Calculates the current percentage change from the average enter price and compares it with the take profit value.
declare function TakeProfit(percentage: number | HaasNumberCollection, positionId?: string, direction?: EnumPosition): boolean

-- Calculates the defined position's current ROI percentage and gives a signal if the set profit is reached.
declare function TakeProfitROI(percentage: number | HaasNumberCollection, positionId?: string, direction?: EnumPosition): boolean

-- Gets takers fee of the market.
declare function TakersFee(market?: string): number

-- Calculates the tangent of the specified angle.
declare function Tan(input: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Calculates the hyperbolic tangent of the specified angle.
declare function Tanh(input: number | number[] | HaasNumberCollection): HaasNumberCollection

-- Gets the current unix timestamp. Based on UTC.
declare function Time(): number

-- Gets the trade amount setting.
declare function TradeAmount(): number

-- Checks the safety, indicator & insurance signal. If a safety is active, DoExitPosition() will be executed. When there are no safeties active, the indicator signal will be executed if the insurances agree.
declare function TradeBotContainer(safetySignal?: boolean, indicatorSignal?: Enum, insuranceSignal?: boolean): nil

interface TradeMarketContainerResult { baseCurrency: string; quoteCurrency: string; contractName: string; contractValue: number; makersFee: number; takersFee: number; underlyingAsset: string; minimumTradeAmount: number; minimumTradeVolume: number; calculatedMinTradeAmount: number; profitLabel: string; amountLabel: string; marketType: EnumTrading; 1: string; 2: string; 3: string; 4: number; 5: number; 6: number; 7: string; 8: number; 9: number; 10: number; 11: string; 12: string; 13: EnumTrading; [index: number]: EnumTrading | number | string }

-- Retrieves all the information on the trade market.
declare function TradeMarketContainer(market?: string): TradeMarketContainerResult

-- Only allows a trade to occur once per bar. Signals produced during a traded bar are blocked.
declare function TradeOncePerBar(interval?: number | HaasNumberCollection, positionId?: string): boolean

-- Checks the current market condition for sideways movement.
declare function TradeOnlySideways(threshold?: number | HaasNumberCollection, interval?: number | HaasNumberCollection, fullCandles?: boolean, market?: string): boolean

-- Checks the current market condition for a trend.
declare function TradeOnlyTrending(threshold?: number | HaasNumberCollection, interval?: number | HaasNumberCollection, fullCandles?: boolean, market?: string): boolean

-- Keeps track of the highest/lowest recorded price and adjust the stop loss accordingly when the arm% has been reached.
declare function TrailingArmStopLoss(percentage: number | HaasNumberCollection, arm: number | HaasNumberCollection, positionId?: string, direction?: EnumPosition): boolean

-- Keeps track of the highest/lowest recorded price and adjust the stop loss accordingly.
declare function TrailingStopLoss(percentage: number | HaasNumberCollection, positionId?: string, direction?: EnumPosition): boolean

-- Truncates a value (or values if table) to the nearest integer or to the specified number of fractional digits.
declare function Truncate(input: number | number[] | HaasNumberCollection, digits: number | HaasNumberCollection): HaasNumberCollection

-- The UpDown RSI (UDRSI) is an RSI Based Indicator that uses
-- an alternative formula to calculate the momentum oscillator. This Indicator works exactly like
-- RSI but instead of determining this from the difference in price, it is calculated by what
-- is called trend stepping. Trend stepping basically measures the closing price of a range of
-- candles and when the price of one candle is lower than the next, it is calculated as 1 price
-- step up. Because of this alternative calculation of Relative Strength Index, Up Down RSI
-- produces some unique Trade Signals.
declare function UDRSI(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- The Ultimate Oscillator (ULTOSC), developed by Larry Williams,
-- is a momentum oscillator designed to capture momentum across three different timeframes.
-- The multiple timeframe objective seeks to avoid the pitfalls of other oscillators. Many
-- momentum oscillators surge at the beginning of a strong advance, only to form a bearish
-- divergence as the advance continues. This is because they are stuck with one timeframe.
-- The Ultimate Oscillator attempts to correct this fault by incorporating longer timeframes
-- into the basic formula. Williams identified a buy signal a based on a bullish divergence
-- and a sell signal based on a bearish divergence.
declare function ULTOSC(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, close: number[] | HaasNumberCollection, periodA: number | HaasNumberCollection, periodB: number | HaasNumberCollection, periodC: number | HaasNumberCollection): HaasNumberCollection

-- Returns the underlying assets of the market. For reflection, in case we are on Bitstamp BTC/USD it will return 'BTC'. When we are on BitMEX XBT/USD (XBTUSD), it will return 'XBT'.
declare function UnderlyingAsset(market?: string): string

-- Marks the signal to be used when its matches a certain signal.
declare function UseSignalIf(signal: Enum, signalToUse: Enum): EnumSignal

-- Calculates the used margin for a specific position.
declare function UsedMargin(market: string, price: number | HaasNumberCollection, amount: number | HaasNumberCollection, leverage: number | HaasNumberCollection): number

interface UserPositionContainerResult { market: string; isLong: boolean; isShort: boolean; enterPrice: number; amount: number; profit: number; roi: number; direction: EnumPosition; 1: string; 2: boolean; 3: boolean; 4: number; 5: number; 6: number; 7: number; 8: EnumPosition; [index: number]: EnumPosition | boolean | number | string }

-- Gets all the information from the open user position.
declare function UserPositionContainer(accountId?: string, market?: string, leverage?: number | HaasNumberCollection, direction?: EnumPosition): UserPositionContainerResult

-- Variance (VAR), developed by Dr. Rene Koch,
-- is the variance ratio indicator that measures the degree of mean reversion or
-- trendiness in a time series. It is an easy and fast way to detect whether
-- a price series is trending, mean reverting or following a random walk.
declare function VAR(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection, deviation: number | HaasNumberCollection): HaasNumberCollection

-- Weighted Close Price (WCLPRICE) is simply an average of an asset's price.
-- It gets its name from the fact that extra weight is given to the closing price.
-- The Median Price (MEDPRICE) and Typical Price (TYPPRICE) are similar indicators.
declare function WCLPRICE(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, close: number[] | HaasNumberCollection): HaasNumberCollection

-- Williams %R (WILLR), also known as the Williams Percent Range,
-- is a type of momentum indicator that moves between 0 and -100 and measures overbought
-- and oversold levels. The Williams %R may be used to find entry and exit points in the market.
-- This indicator is usually plotted on its own chart.
declare function WILLR(high: number[] | HaasNumberCollection, low: number[] | HaasNumberCollection, close: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- The Weighted Moving Average (WMA) puts more weight on recent
-- data and less on past data. This is done by multiplying each bar's price by
-- a weighting factor. Because of its unique calculation, WMA will follow prices
-- more closely than a corresponding Simple Moving Average.
declare function WMA(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- Welles Wilder's Smoothing (WWS), developed by J. Welles Wilder, Jr. and
-- is part of the Wilder's RSI indicator implementation. This indicator smooths price
-- movements to help you identify and spot bullish and bearish trends.
-- This indicator is usually plotted on the price chart.
declare function WWS(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- Blocks any signal until a certain number of minutes have passed since the last placed order. This includes orders executed in an update cycle.
declare function WaitAfterOrder(timeout: number | HaasNumberCollection, positionId?: string): boolean

-- Blocks any signal until a certain number of minutes have passed since the last trade.
declare function WaitAfterTrade(timeout: number | HaasNumberCollection, positionId?: string): boolean

-- Get the available amount in the wallet.
declare function WalletAmount(accountId?: string, coin?: string, market?: string): number

-- Checks if the wallet has enough of the funds.
declare function WalletCheck(accountId: string, coin: string, amount: number | HaasNumberCollection): boolean

-- Wilder Moving Average (WiMA), also called Wilder's Smoothed Moving Average,
-- is similar to the Exponential Moving Average. Compared to other moving averages,
-- Wilder's MA responds more slowly to price changes, where an n-period Wilder MA gives
-- similar values to a 2n- period EMA. For example, a 14-period EMA has almost the
-- same values as a 7-period Wilder MA.
declare function WiMA(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

-- Write data to a file that can be exported later. Only records during a backtest. Self-hosted file size is unlimited, use with caution; cloud servers cap a file at 250,000 rows.
declare function WriteExportData(name: string, ...: any): nil

-- The Zero-Lag Exponential Moving Average (ZLEMA), developed by John Ehlers and Ric Way.
-- As is the case with the double exponential moving average (DEMA) and the triple exponential moving average (TEMA)
-- and as indicated by the name, the aim is to eliminate the inherent lag associated to all trend following
-- indicators which average a price over time. The idea is do a regular exponential moving average (EMA) calculation
-- but on a de-lagged data instead of doing it on the regular data. Data is de-lagged by removing the data from "lag"
-- days ago thus removing (or attempting to) the cumulative effect of the moving average.
declare function ZLEMA(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection): HaasNumberCollection

interface ZLMAResult { ma1: HaasNumberCollection; ma2: HaasNumberCollection; 1: HaasNumberCollection; 2: HaasNumberCollection; [index: number]: HaasNumberCollection }

-- The Zero Lag Moving Average (ZLMA) is the same as ZLEMA, but opens up the possibility to change the
-- type of the moving average. The idea is do a regular moving average (MA) calculation but on a de-lagged data instead of doing
-- it on the regular data. Data is de-lagged by removing the data from "lag" days ago thus removing (or attempting to) the
-- cumulative effect of the moving average.
declare function ZLMA(prices: number[] | HaasNumberCollection, period: number | HaasNumberCollection, maType?: EnumMovingAverages, maPeriod1?: number | HaasNumberCollection, maPeriod2?: number | HaasNumberCollection): ZLMAResult
