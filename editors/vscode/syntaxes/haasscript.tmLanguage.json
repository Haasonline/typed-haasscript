{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HaasScript",
  "scopeName": "source.haasscript",
  "patterns": [
    { "include": "#statements" }
  ],
  "repository": {
    "statements": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#label" },
        { "include": "#function-definition" },
        { "include": "#keyword" },
        { "include": "#constant" },
        { "include": "#function-call" },
        { "include": "#operator" },
        { "include": "#punctuation" }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.block.haasscript",
          "begin": "--\\[(=*)\\[",
          "end": "\\]\\1\\]",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.haasscript" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.haasscript" } }
        },
        {
          "name": "comment.line.double-dash.haasscript",
          "begin": "--",
          "end": "$",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.haasscript" } }
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.haasscript",
          "begin": "\"",
          "end": "\"|$",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.haasscript" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.haasscript" } },
          "patterns": [{ "include": "#escape" }]
        },
        {
          "name": "string.quoted.single.haasscript",
          "begin": "'",
          "end": "'|$",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.haasscript" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.haasscript" } },
          "patterns": [{ "include": "#escape" }]
        },
        {
          "name": "string.quoted.other.multiline.haasscript",
          "begin": "\\[(=*)\\[",
          "end": "\\]\\1\\]",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.haasscript" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.haasscript" } }
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.haasscript",
      "match": "\\\\(?:[abfnrtvz\\\\\"'\\n]|x\\h{2}|\\d{1,3}|u\\{\\h+\\})"
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hexadecimal.haasscript",
          "match": "\\b0[xX]\\h*(?:\\.\\h*)?(?:[pP][-+]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.haasscript",
          "match": "(?:\\b\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][-+]?\\d+)?\\b"
        }
      ]
    },
    "label": {
      "name": "entity.name.label.haasscript",
      "match": "::\\s*[A-Za-z_]\\w*\\s*::"
    },
    "function-definition": {
      "match": "\\b(function)\\s+([A-Za-z_][\\w]*(?:[.:][A-Za-z_]\\w*)*)",
      "captures": {
        "1": { "name": "storage.type.function.haasscript" },
        "2": { "name": "entity.name.function.haasscript" }
      }
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.haasscript",
          "match": "\\b(?:break|do|else|elseif|end|for|goto|if|in|repeat|return|then|until|while)\\b"
        },
        {
          "name": "storage.modifier.local.haasscript",
          "match": "\\blocal\\b"
        },
        {
          "name": "storage.type.function.haasscript",
          "match": "\\bfunction\\b"
        },
        {
          "name": "keyword.operator.logical.haasscript",
          "match": "\\b(?:and|or|not)\\b"
        }
      ]
    },
    "constant": {
      "patterns": [
        {
          "name": "constant.language.haasscript",
          "match": "\\b(?:nil|true|false)\\b"
        },
        {
          "name": "variable.language.self.haasscript",
          "match": "\\bself\\b"
        }
      ]
    },
    "function-call": {
      "match": "\\b([A-Za-z_]\\w*)\\s*(?=[({\"']|\\[=*\\[)",
      "captures": {
        "1": { "name": "entity.name.function.call.haasscript" }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.haasscript",
          "match": "==|~=|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.concatenation.haasscript",
          "match": "\\.\\.(?!\\.)"
        },
        {
          "name": "keyword.operator.arithmetic.haasscript",
          "match": "[-+*/%^#]"
        },
        {
          "name": "keyword.operator.assignment.haasscript",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "keyword.operator.spread.haasscript", "match": "\\.\\.\\." },
        { "name": "punctuation.separator.comma.haasscript", "match": "," },
        { "name": "punctuation.terminator.statement.haasscript", "match": ";" },
        { "name": "punctuation.accessor.haasscript", "match": "[.:]" }
      ]
    }
  }
}
